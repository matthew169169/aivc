# Copy to deploy/cloud.env on the cloud VM. Keep it out of Git.
STUDIO_IMAGE=aivc:cloud
STUDIO_DOMAIN=your-free-dns-hostname.example
STUDIO_ORIGIN=https://your-free-dns-hostname.example
OMICS_GEM_AUTH_ENABLED=true
# Generate these with: docker run --rm -it --entrypoint python aivc:cloud tools/cloud_credentials.py
OMICS_GEM_PASSWORD_HASH=
OMICS_GEM_SESSION_SECRET=
